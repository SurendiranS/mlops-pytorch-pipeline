FROM python:3.11-slim AS base
WORKDIR /app
COPY requirements/serve.txt .
RUN pip install --no-cache-dir -r serve.txt


FROM base AS serving
WORKDIR /app
COPY src/model.py ./src/model.py
COPY src/serve.py ./src/serve.py
RUN useradd --create-home --shell /bin/bash appuser
RUN mkdir -p /app/checkpoints && \
    chown -R appuser:appuser /app

ENV MODEL_PATH=/app/checkpoints/fashion_mnist_cnn.pth
ENV PYTHONUNBUFFERED=1

USER appuser
EXPOSE 8080
HEALTHCHECK --interval=30s \
            --timeout=5s \
            --start-period=10s \
            --retries=3 \
            CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8080/health')" || exit 1

CMD ["uvicorn", "src.serve:app", "--host", "0.0.0.0", "--port", "8080"]